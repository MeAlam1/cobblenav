---
import type { Ingredient } from "../../types";
import { getItemHyperlink } from "../../content/idMappings";

interface Props {
    template: string | Ingredient | null;
    baseItem: string | Ingredient;
    additionItem: string | Ingredient;
    resultItem: Ingredient | string;
    name?: string;
    description?: string;
}

const { template, baseItem, additionItem, resultItem, name, description } =
    Astro.props;

// Helper to construct image paths from your public folder
const getTexturePath = (item: string | Ingredient | null) => {
    if (!item) return null;
    if (typeof item === "string") {
        return `/textures/minecraft/${item}.png`;
    }
    return `/textures/${item.modId}/${item.itemId}.png`;
};

// Helper to format item names (e.g., "diamond_pickaxe" → "Diamond Pickaxe")
const formatItemName = (item: string | Ingredient | null) => {
    if (!item) return "Empty";
    if (typeof item === "string") {
        return item
            .split("_")
            .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
            .join(" ");
    }
    return item.itemId
        .split("_")
        .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
        .join(" ");
};
---

<div class="recipe-container">
    {name && <h2 class="recipe-name">{name}</h2>}
    {description && <p class="recipe-description">{description}</p>}
    <div class="smithing-recipe">
        <!-- Template Slot -->
        <div class="smithing-slot-container">
            <div class="slot-label">Template</div>
            {
                (() => {
                    const link = getItemHyperlink(template);
                    const tooltip = formatItemName(template);
                    return link ? (
                        <a
                            href={link}
                            target={
                                link.startsWith("http") ? "_blank" : undefined
                            }
                            rel={
                                link.startsWith("http")
                                    ? "noopener noreferrer"
                                    : undefined
                            }
                            class="smithing-slot has-link"
                            data-tooltip={tooltip}
                        >
                            {template && (
                                <img
                                    src={getTexturePath(template)}
                                    alt={tooltip}
                                    class="item-texture"
                                />
                            )}
                        </a>
                    ) : (
                        <div class="smithing-slot" data-tooltip={tooltip}>
                            {template && (
                                <img
                                    src={getTexturePath(template)}
                                    alt={tooltip}
                                    class="item-texture"
                                />
                            )}
                        </div>
                    );
                })()
            }
        </div>

        <!-- Base Item Slot -->
        <div class="smithing-slot-container">
            <div class="slot-label">Base</div>
            {
                (() => {
                    const link = getItemHyperlink(baseItem);
                    const tooltip = formatItemName(baseItem);
                    return link ? (
                        <a
                            href={link}
                            target={
                                link.startsWith("http") ? "_blank" : undefined
                            }
                            rel={
                                link.startsWith("http")
                                    ? "noopener noreferrer"
                                    : undefined
                            }
                            class="smithing-slot has-link"
                            data-tooltip={tooltip}
                        >
                            <img
                                src={getTexturePath(baseItem)}
                                alt={tooltip}
                                class="item-texture"
                            />
                        </a>
                    ) : (
                        <div class="smithing-slot" data-tooltip={tooltip}>
                            <img
                                src={getTexturePath(baseItem)}
                                alt={tooltip}
                                class="item-texture"
                            />
                        </div>
                    );
                })()
            }
        </div>

        <!-- Addition Item Slot -->
        <div class="smithing-slot-container">
            <div class="slot-label">Addition</div>
            {
                (() => {
                    const link = getItemHyperlink(additionItem);
                    const tooltip = formatItemName(additionItem);
                    return link ? (
                        <a
                            href={link}
                            target={
                                link.startsWith("http") ? "_blank" : undefined
                            }
                            rel={
                                link.startsWith("http")
                                    ? "noopener noreferrer"
                                    : undefined
                            }
                            class="smithing-slot has-link"
                            data-tooltip={tooltip}
                        >
                            <img
                                src={getTexturePath(additionItem)}
                                alt={tooltip}
                                class="item-texture"
                            />
                        </a>
                    ) : (
                        <div class="smithing-slot" data-tooltip={tooltip}>
                            <img
                                src={getTexturePath(additionItem)}
                                alt={tooltip}
                                class="item-texture"
                            />
                        </div>
                    );
                })()
            }
        </div>

        <!-- Arrow -->
        <div class="smithing-arrow">→</div>

        <!-- Result Slot -->
        <div class="smithing-result-container">
            <div class="slot-label">Result</div>
            {
                (() => {
                    const link = getItemHyperlink(resultItem);
                    const tooltip = formatItemName(resultItem);
                    return link ? (
                        <a
                            href={link}
                            target={
                                link.startsWith("http") ? "_blank" : undefined
                            }
                            rel={
                                link.startsWith("http")
                                    ? "noopener noreferrer"
                                    : undefined
                            }
                            class="smithing-result has-link"
                            data-tooltip={tooltip}
                        >
                            <img
                                src={getTexturePath(resultItem)}
                                alt={tooltip}
                                class="item-texture"
                            />
                        </a>
                    ) : (
                        <div class="smithing-result" data-tooltip={tooltip}>
                            <img
                                src={getTexturePath(resultItem)}
                                alt={tooltip}
                                class="item-texture"
                            />
                        </div>
                    );
                })()
            }
        </div>
    </div>
</div>

<style is:global>
    @font-face {
        font-family: "Minecraft";
        src: url("/font/Monocraft.ttf") format("truetype");
        font-weight: normal;
        font-style: normal;
    }
</style>

<style>
    .recipe-container {
        display: flex;
        flex-direction: column;
        gap: 16px;
        padding: 24px;
        background: linear-gradient(
            135deg,
            rgba(40, 40, 45, 0.6) 0%,
            rgba(25, 25, 30, 0.8) 100%
        );
        border: 2px solid rgba(139, 139, 139, 0.3);
        border-radius: 8px;
        box-shadow:
            0 8px 16px rgba(0, 0, 0, 0.4),
            inset 0 1px 0 rgba(255, 255, 255, 0.05);
        width: fit-content;
        backdrop-filter: blur(10px);
    }

    :global(html[data-theme="light"]) .recipe-container {
        background: linear-gradient(
            135deg,
            rgba(240, 240, 245, 0.9) 0%,
            rgba(220, 220, 230, 0.95) 100%
        );
        border: 2px solid rgba(100, 100, 110, 0.3);
        box-shadow:
            0 8px 16px rgba(0, 0, 0, 0.15),
            inset 0 1px 0 rgba(255, 255, 255, 0.8);
    }

    .recipe-name {
        font-family: "Minecraft", monospace, sans-serif;
        font-size: 2rem;
        font-weight: normal;
        color: #ffffff;
        text-shadow:
            3px 3px 0px #3f3f3f,
            -1px -1px 0px rgba(0, 0, 0, 0.5),
            0 0 20px rgba(255, 255, 255, 0.1);
        margin: 0;
        padding-bottom: 8px;
        letter-spacing: 1px;
        image-rendering: pixelated;
        border-bottom: 2px solid rgba(139, 139, 139, 0.3);
    }

    :global(html[data-theme="light"]) .recipe-name {
        color: #2d2d2d;
        text-shadow:
            3px 3px 0px rgba(150, 150, 150, 0.4),
            -1px -1px 0px rgba(255, 255, 255, 0.8),
            0 0 20px rgba(0, 0, 0, 0.1);
        border-bottom-color: rgba(100, 100, 110, 0.3);
    }

    .recipe-description {
        font-family: "Minecraft", monospace, sans-serif;
        font-size: 1rem;
        color: #b8b8b8;
        text-shadow:
            2px 2px 0px rgba(0, 0, 0, 0.6),
            0 0 10px rgba(0, 0, 0, 0.3);
        margin: 0;
        padding: 0;
        line-height: 1.6;
        max-width: 500px;
    }

    :global(html[data-theme="light"]) .recipe-description {
        color: #4a4a4a;
        text-shadow:
            2px 2px 0px rgba(200, 200, 200, 0.5),
            0 0 10px rgba(0, 0, 0, 0.05);
    }

    .smithing-recipe {
        display: flex;
        align-items: center;
        gap: 16px;
        background: linear-gradient(135deg, #c6c6c6 0%, #8b8b8b 100%);
        padding: 20px 24px;
        border-top: 3px solid #ffffff;
        border-left: 3px solid #ffffff;
        border-right: 3px solid #373737;
        border-bottom: 3px solid #373737;
        box-shadow:
            inset 0 0 0 1px #555555,
            0 4px 8px rgba(0, 0, 0, 0.4);
        width: fit-content;
        font-family: "Minecraft", monospace, sans-serif;
        image-rendering: pixelated;
        user-select: none;
    }

    .smithing-slot-container,
    .smithing-result-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
    }

    .slot-label {
        font-size: 0.75rem;
        color: #3f3f3f;
        text-shadow: 1px 1px 0 rgba(255, 255, 255, 0.3);
        font-family: "Minecraft", monospace, sans-serif;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .smithing-slot,
    .smithing-result {
        width: 54px;
        height: 54px;
        background: linear-gradient(135deg, #8b8b8b 0%, #646464 100%);
        border-top: 2px solid #373737;
        border-left: 2px solid #373737;
        border-right: 2px solid #ffffff;
        border-bottom: 2px solid #ffffff;
        box-shadow:
            inset 1px 1px 0 0 rgba(0, 0, 0, 0.5),
            inset -1px -1px 0 0 rgba(255, 255, 255, 0.3);
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        box-sizing: border-box;
        text-decoration: none;
        color: inherit;
    }

    a.smithing-slot,
    a.smithing-result,
    .smithing-slot.has-link,
    .smithing-result.has-link {
        cursor: pointer;
    }

    .smithing-slot[data-tooltip]:hover::after,
    .smithing-result[data-tooltip]:hover::after {
        content: attr(data-tooltip);
        position: absolute;
        bottom: 100%;
        left: 50%;
        transform: translateX(-50%) translateY(-8px);
        padding: 6px 10px;
        background: linear-gradient(180deg, #100010 0%, #100010 100%);
        border: 2px solid;
        border-color: #5000ff #2800aa #2800aa #5000ff;
        color: #ffffff;
        font-family: "Minecraft", monospace, sans-serif;
        font-size: 16px;
        pointer-events: none;
        z-index: 10000;
        white-space: nowrap;
        text-shadow: 2px 2px 0px rgba(0, 0, 0, 0.8);
        box-shadow:
            inset 0 0 0 1px rgba(80, 0, 255, 0.4),
            0 4px 8px rgba(0, 0, 0, 0.6);
        image-rendering: pixelated;
        animation: tooltipFadeIn 0.15s ease;
    }

    @keyframes tooltipFadeIn {
        from {
            opacity: 0;
            transform: translateX(-50%) translateY(-4px);
        }
        to {
            opacity: 1;
            transform: translateX(-50%) translateY(-8px);
        }
    }

    .smithing-slot:hover,
    .smithing-result:hover {
        background: linear-gradient(135deg, #a0a0a0 0%, #787878 100%);
    }

    .smithing-arrow {
        font-size: 2rem;
        color: #373737;
        font-weight: bold;
        text-shadow:
            1px 1px 0 #ffffff,
            -1px -1px 0 rgba(0, 0, 0, 0.2);
        filter: drop-shadow(2px 2px 2px rgba(0, 0, 0, 0.3));
        margin: 0 4px;
        margin-top: 20px;
    }

    .item-texture {
        width: 40px;
        height: 40px;
        object-fit: contain;
        filter: drop-shadow(1px 1px 1px rgba(0, 0, 0, 0.3));
    }
</style>
