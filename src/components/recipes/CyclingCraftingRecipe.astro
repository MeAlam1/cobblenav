---
import type { Ingredient, CraftingRecipeVariant } from "../../types";
import { getItemHyperlink } from "../../content/idMappings";

interface Props {
    /** An array of crafting recipe variants to cycle between */
    recipes?: CraftingRecipeVariant[];
    variants?: CraftingRecipeVariant[];
    /** Single recipe fallback props */
    ingredients?: (string | Ingredient | null)[];
    resultItem?: Ingredient | string;
    resultCount?: number;
    /** Common / fallback name and description */
    name?: string;
    description?: string;
    /** Cycle interval in milliseconds (default: 2000 = 2 seconds) */
    interval?: number;
}

const {
    recipes,
    variants,
    ingredients,
    resultItem,
    resultCount = 1,
    name,
    description,
    interval = 2000,
} = Astro.props;

// Consolidate recipes into an array
const recipeVariants: CraftingRecipeVariant[] =
    variants ??
    recipes ??
    (ingredients && resultItem
        ? [
              {
                  name,
                  description,
                  ingredients,
                  resultItem,
                  resultCount,
              },
          ]
        : []);

// Helper to construct image paths from public folder
const getTexturePath = (item: string | Ingredient | null) => {
    if (!item) return null;
    if (typeof item === "string") {
        return `/textures/minecraft/${item}.png`;
    }
    return `/textures/${item.modId}/${item.itemId}.png`;
};

// Helper to format item names (e.g., "diamond_pickaxe" → "Diamond Pickaxe")
const formatItemName = (item: string | Ingredient | null) => {
    if (!item) return "Empty";
    if (typeof item === "string") {
        return item
            .split("_")
            .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
            .join(" ");
    }
    return item.itemId
        .split("_")
        .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
        .join(" ");
};
---

<div class="recipe-container cycling-crafting-recipe" data-interval={interval}>
    {
        recipeVariants.map((variant, index) => {
            const variantName = variant.name || name;
            const variantDesc = variant.description || description;
            const count = variant.resultCount ?? 1;

            return (
                <div
                    class={`recipe-variant ${index === 0 ? "active" : ""}`}
                    data-variant-index={index}
                >
                    {variantName && <h2 class="recipe-name">{variantName}</h2>}
                    {variantDesc && (
                        <p class="recipe-description">{variantDesc}</p>
                    )}
                    <div class="minecraft-recipe">
                        <div class="recipe-grid">
                            {variant.ingredients.map((item) => {
                                const texture = getTexturePath(item);
                                const link = getItemHyperlink(item);
                                const tooltip = formatItemName(item);
                                return link ? (
                                    <a
                                        href={link}
                                        target={
                                            link.startsWith("http")
                                                ? "_blank"
                                                : undefined
                                        }
                                        rel={
                                            link.startsWith("http")
                                                ? "noopener noreferrer"
                                                : undefined
                                        }
                                        class="recipe-slot has-link"
                                        data-tooltip={tooltip}
                                    >
                                        {texture && (
                                            <img
                                                src={texture}
                                                alt={tooltip}
                                                class="item-texture"
                                            />
                                        )}
                                    </a>
                                ) : (
                                    <div
                                        class="recipe-slot"
                                        data-tooltip={tooltip}
                                    >
                                        {texture && (
                                            <img
                                                src={texture}
                                                alt={tooltip}
                                                class="item-texture"
                                            />
                                        )}
                                    </div>
                                );
                            })}
                        </div>

                        <div class="recipe-arrow">→</div>

                        <div class="recipe-result-container">
                            {(() => {
                                const link = getItemHyperlink(
                                    variant.resultItem,
                                );
                                const tooltip = formatItemName(
                                    variant.resultItem,
                                );
                                return link ? (
                                    <a
                                        href={link}
                                        target={
                                            link.startsWith("http")
                                                ? "_blank"
                                                : undefined
                                        }
                                        rel={
                                            link.startsWith("http")
                                                ? "noopener noreferrer"
                                                : undefined
                                        }
                                        class="recipe-result has-link"
                                        data-tooltip={tooltip}
                                    >
                                        <img
                                            src={getTexturePath(
                                                variant.resultItem,
                                            )}
                                            alt={tooltip}
                                            class="item-texture"
                                        />
                                        {count > 1 && (
                                            <span class="item-count">
                                                {count}
                                            </span>
                                        )}
                                    </a>
                                ) : (
                                    <div
                                        class="recipe-result"
                                        data-tooltip={tooltip}
                                    >
                                        <img
                                            src={getTexturePath(
                                                variant.resultItem,
                                            )}
                                            alt={tooltip}
                                            class="item-texture"
                                        />
                                        {count > 1 && (
                                            <span class="item-count">
                                                {count}
                                            </span>
                                        )}
                                    </div>
                                );
                            })()}
                        </div>
                    </div>
                </div>
            );
        })
    }

    {
        recipeVariants.length > 1 && (
            <div class="recipe-dots-container">
                {recipeVariants.map((variant, index) => (
                    <button
                        type="button"
                        class={`recipe-dot ${index === 0 ? "active" : ""}`}
                        data-dot-index={index}
                        aria-label={`Switch to ${variant.name || `Variant ${index + 1}`}`}
                        title={variant.name || `Variant ${index + 1}`}
                    />
                ))}
            </div>
        )
    }
</div>

<script>
    function initCyclingRecipes() {
        const containers = document.querySelectorAll<HTMLElement>(
            ".cycling-crafting-recipe",
        );

        containers.forEach((container) => {
            if (container.dataset.initialized === "true") return;
            container.dataset.initialized = "true";

            const variants =
                container.querySelectorAll<HTMLElement>(".recipe-variant");
            const dots = container.querySelectorAll<HTMLElement>(".recipe-dot");
            const count = variants.length;
            if (count <= 1) return;

            const intervalMs =
                parseInt(container.dataset.interval || "5000", 10) || 5000;

            let currentIndex = 0;
            let timer: number | undefined;

            function showVariant(index: number) {
                currentIndex = (index + count) % count;
                variants.forEach((el, i) => {
                    if (i === currentIndex) {
                        el.classList.add("active");
                    } else {
                        el.classList.remove("active");
                    }
                });
                dots.forEach((dot, i) => {
                    if (i === currentIndex) {
                        dot.classList.add("active");
                        dot.setAttribute("aria-current", "true");
                    } else {
                        dot.classList.remove("active");
                        dot.removeAttribute("aria-current");
                    }
                });
            }

            function startTimer() {
                if (timer) clearInterval(timer);
                timer = window.setInterval(() => {
                    showVariant(currentIndex + 1);
                }, intervalMs);
            }

            function stopTimer() {
                if (timer) {
                    clearInterval(timer);
                    timer = undefined;
                }
            }

            // Pause cycling when hovering so users can inspect tooltips
            container.addEventListener("mouseenter", stopTimer);
            container.addEventListener("mouseleave", startTimer);

            // Dot click navigation
            dots.forEach((dot, i) => {
                dot.addEventListener("click", (e) => {
                    e.preventDefault();
                    showVariant(i);
                    startTimer();
                });
            });

            startTimer();
        });
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initCyclingRecipes);
    } else {
        initCyclingRecipes();
    }
    document.addEventListener("astro:page-load", initCyclingRecipes);
</script>

<style is:global>
    @font-face {
        font-family: "Minecraft";
        src: url("/font/Monocraft.ttf") format("truetype");
        font-weight: normal;
        font-style: normal;
    }
</style>

<style>
    .recipe-container {
        display: flex;
        flex-direction: column;
        gap: 16px;
        padding: 24px;
        background: linear-gradient(
            135deg,
            rgba(40, 40, 45, 0.6) 0%,
            rgba(25, 25, 30, 0.8) 100%
        );
        border: 2px solid rgba(139, 139, 139, 0.3);
        border-radius: 8px;
        box-shadow:
            0 8px 16px rgba(0, 0, 0, 0.4),
            inset 0 1px 0 rgba(255, 255, 255, 0.05);
        width: fit-content;
        backdrop-filter: blur(10px);
    }

    :global(html[data-theme="light"]) .recipe-container {
        background: linear-gradient(
            135deg,
            rgba(240, 240, 245, 0.9) 0%,
            rgba(220, 220, 230, 0.95) 100%
        );
        border: 2px solid rgba(100, 100, 110, 0.3);
        box-shadow:
            0 8px 16px rgba(0, 0, 0, 0.15),
            inset 0 1px 0 rgba(255, 255, 255, 0.8);
    }

    .recipe-variant {
        display: none;
        flex-direction: column;
        gap: 16px;
        width: 100%;
    }

    .recipe-variant.active {
        display: flex;
    }

    .recipe-name {
        font-family: "Minecraft", monospace, sans-serif;
        font-size: 2rem;
        font-weight: normal;
        color: #ffffff;
        text-shadow:
            3px 3px 0px #3f3f3f,
            -1px -1px 0px rgba(0, 0, 0, 0.5),
            0 0 20px rgba(255, 255, 255, 0.1);
        margin: 0;
        padding-bottom: 8px;
        letter-spacing: 1px;
        image-rendering: pixelated;
        border-bottom: 2px solid rgba(139, 139, 139, 0.3);
    }

    :global(html[data-theme="light"]) .recipe-name {
        color: #2d2d2d;
        text-shadow:
            3px 3px 0px rgba(150, 150, 150, 0.4),
            -1px -1px 0px rgba(255, 255, 255, 0.8),
            0 0 20px rgba(0, 0, 0, 0.1);
        border-bottom-color: rgba(100, 100, 110, 0.3);
    }

    .recipe-description {
        font-family: "Minecraft", monospace, sans-serif;
        font-size: 1rem;
        color: #b8b8b8;
        text-shadow:
            2px 2px 0px rgba(0, 0, 0, 0.6),
            0 0 10px rgba(0, 0, 0, 0.3);
        margin: 0;
        padding: 0;
        line-height: 1.6;
        max-width: 500px;
    }

    :global(html[data-theme="light"]) .recipe-description {
        color: #4a4a4a;
        text-shadow:
            2px 2px 0px rgba(200, 200, 200, 0.5),
            0 0 10px rgba(0, 0, 0, 0.05);
    }

    .minecraft-recipe {
        display: flex;
        align-items: center;
        gap: 24px;
        background: linear-gradient(135deg, #c6c6c6 0%, #8b8b8b 100%);
        padding: 20px 24px;
        border-top: 3px solid #ffffff;
        border-left: 3px solid #ffffff;
        border-right: 3px solid #373737;
        border-bottom: 3px solid #373737;
        box-shadow:
            inset 0 0 0 1px #555555,
            0 4px 8px rgba(0, 0, 0, 0.4);
        width: fit-content;
        font-family: "Minecraft", monospace, sans-serif;
        image-rendering: pixelated;
        user-select: none;
    }

    .recipe-grid {
        display: grid;
        grid-template-columns: repeat(3, 54px);
        grid-template-rows: repeat(3, 54px);
        gap: 3px;
        background-color: #373737;
        padding: 3px;
        box-shadow:
            inset 2px 2px 0 0 #1a1a1a,
            inset -1px -1px 0 0 #5a5a5a;
    }

    .recipe-slot,
    .recipe-result {
        background: linear-gradient(135deg, #8b8b8b 0%, #646464 100%);
        border-top: 2px solid #373737;
        border-left: 2px solid #373737;
        border-right: 2px solid #ffffff;
        border-bottom: 2px solid #ffffff;
        box-shadow:
            inset 1px 1px 0 0 rgba(0, 0, 0, 0.5),
            inset -1px -1px 0 0 rgba(255, 255, 255, 0.3);
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 100%;
        box-sizing: border-box;
        text-decoration: none;
        color: inherit;
    }

    a.recipe-slot,
    a.recipe-result,
    .recipe-slot.has-link,
    .recipe-result.has-link {
        cursor: pointer;
    }

    .recipe-slot[data-tooltip]:hover::after,
    .recipe-result[data-tooltip]:hover::after {
        content: attr(data-tooltip);
        position: absolute;
        bottom: 100%;
        left: 50%;
        transform: translateX(-50%) translateY(-8px);
        padding: 6px 10px;
        background: linear-gradient(180deg, #100010 0%, #100010 100%);
        border: 2px solid;
        border-color: #5000ff #2800aa #2800aa #5000ff;
        color: #ffffff;
        font-family: "Minecraft", monospace, sans-serif;
        font-size: 16px;
        pointer-events: none;
        z-index: 10000;
        white-space: nowrap;
        text-shadow: 2px 2px 0px rgba(0, 0, 0, 0.8);
        image-rendering: pixelated;
        animation: tooltipFadeIn 0.15s ease;
    }

    @keyframes tooltipFadeIn {
        from {
            opacity: 0;
            transform: translateX(-50%) translateY(-4px);
        }
        to {
            opacity: 1;
            transform: translateX(-50%) translateY(-8px);
        }
    }

    .recipe-slot:hover,
    .recipe-result:hover {
        background: linear-gradient(135deg, #a0a0a0 0%, #787878 100%);
    }

    .recipe-arrow {
        font-size: 2.5rem;
        color: #373737;
        font-weight: bold;
        text-shadow:
            1px 1px 0 #ffffff,
            -1px -1px 0 rgba(0, 0, 0, 0.2);
        filter: drop-shadow(2px 2px 2px rgba(0, 0, 0, 0.3));
    }

    .recipe-result-container {
        width: 64px;
        height: 64px;
        background: linear-gradient(135deg, #8b8b8b 0%, #646464 100%);
        border-top: 2px solid #373737;
        border-left: 2px solid #373737;
        border-right: 2px solid #ffffff;
        border-bottom: 2px solid #ffffff;
        box-shadow:
            inset 1px 1px 0 0 rgba(0, 0, 0, 0.5),
            inset -1px -1px 0 0 rgba(255, 255, 255, 0.3);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .recipe-result-container:hover {
        background: linear-gradient(135deg, #a0a0a0 0%, #787878 100%);
    }

    .item-texture {
        width: 36px;
        height: 36px;
        object-fit: contain;
        filter: drop-shadow(1px 1px 1px rgba(0, 0, 0, 0.3));
    }

    .recipe-result .item-texture {
        width: 44px;
        height: 44px;
    }

    .item-count {
        position: absolute;
        bottom: 3px;
        right: 5px;
        font-size: 0.9rem;
        font-weight: bold;
        color: #ffffff;
        text-shadow:
            2px 2px 0px #3f3f3f,
            -1px -1px 0px rgba(0, 0, 0, 0.5);
        font-family: "Minecraft", monospace, sans-serif;
    }

    .recipe-dots-container {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 8px;
        padding-top: 4px;
    }

    .recipe-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.3);
        border: 1px solid rgba(0, 0, 0, 0.4);
        padding: 0;
        cursor: pointer;
        transition:
            background 0.2s ease,
            transform 0.2s ease;
    }

    .recipe-dot:hover {
        background: rgba(255, 255, 255, 0.6);
        transform: scale(1.25);
    }

    .recipe-dot.active {
        background: #ffffff;
        box-shadow: 0 0 6px rgba(255, 255, 255, 0.8);
        transform: scale(1.25);
    }

    :global(html[data-theme="light"]) .recipe-dot {
        background: rgba(0, 0, 0, 0.2);
        border: 1px solid rgba(255, 255, 255, 0.4);
    }

    :global(html[data-theme="light"]) .recipe-dot:hover {
        background: rgba(0, 0, 0, 0.5);
    }

    :global(html[data-theme="light"]) .recipe-dot.active {
        background: #373737;
        box-shadow: 0 0 6px rgba(0, 0, 0, 0.4);
    }
</style>
