---
interface Props {
    projectId: string;
    label?: string;
}

const { projectId, label = "Latest Release" } = Astro.props;

const modrinthUrl = `https://modrinth.com/mod/${projectId}`;
const apiUrl = `https://api.modrinth.com/v2/project/${projectId}/version`;

let initialVersion = "Unknown";
let releaseUrl = modrinthUrl;

try {
    const response = await fetch(apiUrl);

    if (response.ok) {
        const data = await response.json();
        if (Array.isArray(data) && data.length > 0) {
            // Get the first (latest) version
            const latestVersion = data[0];
            initialVersion =
                latestVersion.version_number ??
                latestVersion.name ??
                initialVersion;
            releaseUrl = latestVersion.version_type ? modrinthUrl : modrinthUrl;
        }
    }
} catch {
    // Keep graceful fallbacks when network calls fail during docs build.
}
---

<div
    class="live-version-content not-content"
    data-live-version-detector
    data-project-id={projectId}
    data-initial-version={initialVersion}
>
    <div class="meta-row">
        <div class="meta-label">{label}</div>
        <div class="meta-value">
            <a
                href={releaseUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="version-box"
                data-version-link
                data-tooltip={`View on Modrinth: ${projectId}`}
            >
                <span data-version-value>{initialVersion}</span>
            </a>
            <span class="status-text" data-version-status>
                Checking for updates...
            </span>
        </div>
    </div>
</div>

<script>
    const updateLiveVersionDetectors = async () => {
        const detectorElements = document.querySelectorAll(
            "[data-live-version-detector]",
        );

        await Promise.all(
            Array.from(detectorElements).map(async (element) => {
                const projectId = element.getAttribute("data-project-id");

                if (!projectId) {
                    return;
                }

                const versionStatus = element.querySelector(
                    "[data-version-status]",
                );
                const versionLink = element.querySelector("[data-version-link]");
                const versionValue = element.querySelector(
                    "[data-version-value]",
                );

                try {
                    const response = await fetch(
                        `https://api.modrinth.com/v2/project/${projectId}/version`,
                        {
                            cache: "no-store",
                        },
                    );

                    if (!response.ok) {
                        throw new Error(
                            `Modrinth API request failed: ${response.status}`,
                        );
                    }

                    const data = await response.json();
                    if (!Array.isArray(data) || data.length === 0) {
                        if (versionStatus) {
                            versionStatus.textContent = "No releases found";
                            versionStatus.classList.remove(
                                "status-success",
                                "status-error",
                            );
                            versionStatus.classList.add("status-warning");
                        }
                        return;
                    }

                    const latestVersion = data[0];
                    const version =
                        latestVersion.version_number ?? latestVersion.name;
                    const modrinthUrl = `https://modrinth.com/mod/${projectId}`;

                    if (!version) {
                        if (versionStatus) {
                            versionStatus.textContent = "No releases found";
                            versionStatus.classList.remove(
                                "status-success",
                                "status-error",
                            );
                            versionStatus.classList.add("status-warning");
                        }
                        return;
                    }

                    if (versionValue) {
                        versionValue.textContent = version;
                    }

                    if (versionLink) {
                        versionLink.setAttribute("href", modrinthUrl);
                    }

                    if (versionStatus) {
                        versionStatus.textContent = "Up to date";
                        versionStatus.classList.remove(
                            "status-warning",
                            "status-error",
                        );
                        versionStatus.classList.add("status-success");
                    }
                } catch {
                    if (versionStatus) {
                        versionStatus.textContent = "Not available";
                        versionStatus.classList.remove(
                            "status-success",
                            "status-warning",
                        );
                        versionStatus.classList.add("status-error");
                    }
                }
            }),
        );
    };

    // Re-run after client-side navigations as well as on the initial load.
    document.addEventListener("astro:page-load", updateLiveVersionDetectors);
    updateLiveVersionDetectors();
</script>

<style is:global>
    @font-face {
        font-family: "Minecraft";
        src: url("/font/Monocraft.ttf") format("truetype");
        font-weight: normal;
        font-style: normal;
    }

    :root {
        --minecraft-color-green: #55ff55;
        --minecraft-color-red: #ff3737;
        --minecraft-color-yellow: #ffff55;
    }
</style>

<style>
    .live-version-content {
        display: flex;
        flex-direction: column;
        height: fit-content;
        gap: 12px;
        background: linear-gradient(135deg, #c6c6c6 0%, #8b8b8b 100%);
        padding: 10px 24px 30px 24px;
        border-top: 3px solid #ffffff;
        border-left: 3px solid #ffffff;
        border-right: 3px solid #373737;
        border-bottom: 3px solid #373737;
        box-shadow:
            inset 0 0 0 1px #555555,
            0 4px 8px rgba(0, 0, 0, 0.4);
        width: fit-content;
        min-width: 450px;
        font-family: "Minecraft", monospace, sans-serif;
        image-rendering: pixelated;
        user-select: none;
    }

    .meta-row {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 4px 0;
    }

    .meta-label {
        font-family: "Minecraft", monospace, sans-serif;
        font-size: 1rem;
        color: #3f3f3f;
        text-shadow: 1px 1px 0 rgba(255, 255, 255, 0.3);
        min-width: 220px;
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .meta-value {
        font-family: "Minecraft", monospace, sans-serif;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
        position: relative;
    }

    .version-box {
        font-family: "Minecraft", monospace, sans-serif;
        font-size: 1rem;
        padding: 8px 16px;
        background: linear-gradient(135deg, #8b8b8b 0%, #646464 100%);
        border-top: 2px solid #373737;
        border-left: 2px solid #373737;
        border-right: 2px solid #ffffff;
        border-bottom: 2px solid #ffffff;
        box-shadow:
            inset 1px 1px 0 0 rgba(0, 0, 0, 0.5),
            inset -1px -1px 0 0 rgba(255, 255, 255, 0.3);
        color: #ffffff;
        text-shadow: 2px 2px 0 rgba(0, 0, 0, 0.8);
        letter-spacing: 1px;
        text-decoration: none;
        transition: transform 0.15s ease;
        position: relative;
    }

    .version-box:hover {
        transform: translateY(-1px) scale(1.02);
    }

    .version-box::after {
        content: attr(data-tooltip);
        position: absolute;
        bottom: 100%;
        left: 50%;
        transform: translateX(-50%) translateY(-8px);
        padding: 6px 10px;
        background: linear-gradient(180deg, #100010 0%, #100010 100%);
        border: 2px solid;
        border-color: #5000ff #2800aa #2800aa #5000ff;
        color: #ffffff;
        font-family: "Minecraft", monospace, sans-serif;
        font-size: 14px;
        pointer-events: none;
        z-index: 10000;
        white-space: nowrap;
        text-shadow: 2px 2px 0 rgba(0, 0, 0, 0.8);
        opacity: 0;
        transition: opacity 0.15s ease-in-out;
    }

    .version-box:hover::after {
        opacity: 1;
    }

    .status-text {
        font-size: 0.9rem;
        font-weight: bold;
        color: #2d2d2d;
        text-shadow: 1px 1px 0 rgba(255, 255, 255, 0.35);
        transition: color 0.15s ease;
        position: absolute;
        bottom: -24px;
        left: 50%;
        transform: translateX(-50%);
        white-space: nowrap;
    }

    .status-text.status-success {
        color: var(--minecraft-color-green);
        text-shadow: 2px 2px 0 rgba(0, 0, 0, 0.831);
    }

    .status-text.status-error {
        color: var(--minecraft-color-red);
        text-shadow: 2px 2px 0 rgba(0, 0, 0, 0.831);
    }

    .status-text.status-warning {
        color: var(--minecraft-color-yellow);
        text-shadow: 2px 2px 0 rgba(0, 0, 0, 0.831);
    }

    @media (max-width: 720px) {
        .live-version-content {
            min-width: auto;
            width: 100%;
            padding: 16px 16px 30px 16px;
        }

        .meta-row {
            flex-direction: column;
            align-items: flex-start;
            gap: 10px;
        }

        .meta-label {
            min-width: auto;
        }
    }
</style>
