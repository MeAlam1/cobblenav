---
// @ts-expect-error - This is a custom Virtual Module
import EditLink from "virtual:starlight/components/EditLink";
// @ts-expect-error - This is a custom Virtual Module
import LastUpdated from "virtual:starlight/components/LastUpdated";
// @ts-expect-error - This is a custom Virtual Module
import Pagination from "virtual:starlight/components/Pagination";
// @ts-expect-error - This is a custom Virtual Module
import config from "virtual:starlight/user-config";
import { Icon } from "@astrojs/starlight/components";
import CobblemonLogo from "~/assets/cobblemon.png";
import { Image } from "astro:assets";
---

<footer class="sl-flex">
    <div class="meta sl-flex">
        <EditLink />
        <LastUpdated />
    </div>
    <Pagination />

    <a class="kudos sl-flex" href="https://cobblemon.com">
        <Image
            src={CobblemonLogo}
            width={24}
            height={24}
            alt="Cobblemon Logo"
        />
        <span>Built with Cobblemon</span>
    </a>

    {
        config.credits && (
            <a class="kudos sl-flex" href="https://starlight.astro.build">
                <Icon name={"starlight"} />{" "}
                {Astro.locals.t("builtWithStarlight.label")}
            </a>
        )
    }
</footer>

<style>
    @layer starlight.core {
        footer {
            flex-direction: column;
            gap: 1.5rem;
        }
        .meta {
            gap: 0.75rem 3rem;
            justify-content: space-between;
            flex-wrap: wrap;
            margin-top: 3rem;
            font-size: var(--sl-text-sm);
            color: var(--sl-color-gray-3);
        }
        .meta > :global(p:only-child) {
            margin-inline-start: auto;
        }

        .kudos {
            align-items: center;
            gap: 0.5em;
            margin: 1.5rem auto;
            font-size: var(--sl-text-xs);
            text-decoration: none;
            color: var(--sl-color-gray-3);
        }
        .kudos:hover {
            color: var(--sl-color-white);
        }
    }

    @layer starlight.components {
        .kudos :global(svg) {
            color: var(--sl-color-orange);
        }
    }
</style>
