{
  "schemaVersion": 1,
  "id": "cobblenav",
  "version": "${version}",
  "name": "Cobblenav",
  "description": "The Cobblenav mod is inspired by the item and related mechanics featured in the games Pokémon RSE and Pokémon ORAS",
  "authors": [
    "MeAlam",
    "gatekeep06"
  ],
  "contact": {
    "sources": "https://github.com/MeAlam1/cobblenav",
    "issues": "https://github.com/MeAlam1/cobblenav/issues"
  },
  "license": "MPL-2.0",
  "icon": "assets/cobblenav/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.metacontent.cobblenav.CobbleNavFabric"
    ],
    "client": [
      "com.metacontent.cobblenav.client.CobblenavFabricClient"
    ],
    "modmenu": [
      "com.metacontent.cobblenav.client.integration.CobblenavModMenu"
    ]
  },
  "mixins": [
    "cobblenav.mixins.json"
